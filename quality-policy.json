{
  "llvm_version": "22.1.8",
  "gcc_version": "15.3.1",
  "profile": ".clang-tidy",
  "owned_roots": ["."],
  "exclude_roots": ["ChibiOS_21.11.5", "libstm32f4", "libcanard", "lispBM", "blackmagic", "tools", "downloads", "build", "tests"],
  "minimum_translation_units": 1,
  "c_standard": "gnu99",
  "cxx_standard": "gnu++14",
  "target": "arm-none-eabi",
  "cpu": "cortex-m4",
  "fpu": "fpv4-sp-d16",
  "float_abi": "hard"
}
