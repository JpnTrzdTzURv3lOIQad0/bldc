-Wall
-Wextra
-Wpedantic
-Werror
-Wformat=2
-Wformat-overflow=2
-Wformat-truncation=2
-Wformat-signedness
-Wconversion
-Wsign-conversion
-Warith-conversion
-Wdouble-promotion
-Wfloat-equal
-Wshadow=global
-Wundef
-Wcast-align=strict
-Wcast-qual
-Wcast-function-type
-Wwrite-strings
-Wpointer-arith
-Wswitch-enum
-Wswitch-default
-Wimplicit-fallthrough=5
-Wvla
-Walloca
-Wtrampolines
-Warray-bounds=2
-Wstringop-overflow=2
-Wstringop-truncation
-Wnull-dereference
-Wduplicated-cond
-Wduplicated-branches
-Wlogical-op
-Wmissing-include-dirs
-Wpacked-not-aligned
-Waddress-of-packed-member
-Wdate-time
-Wtrailing-whitespace=any
-Wstrict-aliasing=3
-Wshift-overflow=2
-fdiagnostics-show-option
