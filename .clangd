# Uses the SAME prepared database as the command-line gate.
# Never remove all -m* or -f*: those include target and semantic options.
# Do not add -std=gnu23 here to mask a GNU99 build; fix the real C commands.
CompileFlags:
  CompilationDatabase: build/analysis
  # clangd does not use .clang-tidy ExtraArgs; repeat frontend diagnostics here.
  Add: [-Wall, -Wextra, -Wpedantic, -Wconversion, -Wsign-conversion,
        -Wdouble-promotion, -Wfloat-equal, -Wshadow, -Wformat=2, -Wundef,
        -Wvla, -Walloca, -Wcast-align, -Wcast-qual, -Wcast-function-type-strict,
        -Wwrite-strings, -Wpointer-arith, -Wswitch-enum, -Wswitch-default,
        -Wimplicit-fallthrough, -Wunreachable-code, -Wunsequenced,
        -Waddress-of-packed-member, -Wdate-time,
        -Werror=unknown-warning-option, -Werror=ignored-optimization-argument,
        -Werror=unused-command-line-argument]
Diagnostics:
  ClangTidy:
    FastCheckFilter: Strict
  UnusedIncludes: None
  MissingIncludes: None
# Interactive checking is intentionally a subset. The full CLI gate is required.
# Include-cleaner is disabled because HAL/RTOS umbrella headers need separate review.
